<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read-write access to files chosen via NSOpen/NSSavePanel — required
         for NSDocument-based .webframes load/save. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Re-open recent documents via security-scoped bookmarks (Open Recent). -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- The sample project server binds only to 127.0.0.1. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
